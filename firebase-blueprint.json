{
  "entities": {
    "ServiceRequest": {
      "title": "Service Request",
      "description": "A customer service request or complaint",
      "type": "object",
      "properties": {
        "full_name": { "type": "string" },
        "complete_address": { "type": "string" },
        "contact_number": { "type": "string" },
        "account_number": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "concerns": { "type": "string" },
        "reference_number": { "type": "string" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in-progress", "resolved", "cancelled"],
          "default": "pending"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["full_name", "contact_number", "concerns", "reference_number"]
    }
  },
  "firestore": {
    "service_requests": {
      "schema": "ServiceRequest",
      "description": "Collection of all customer service requests"
    }
  }
}
